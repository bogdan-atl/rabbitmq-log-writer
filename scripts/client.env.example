# Client mode configuration for Linux server
# Copy this file to /etc/udp-logger/client.env and adjust values

# Cluster mode
CLUSTER_MODE=client
MASTER_ADDR=master.example.com
MASTER_PORT=9999

# TLS configuration (one-way TLS - only CA file needed)
CLUSTER_TLS=true
CLUSTER_CA_FILE=/etc/udp-logger/certs/ca.pem

# Optional: For two-way TLS (mTLS), uncomment these:
# CLUSTER_CERT_FILE=/etc/udp-logger/certs/client.crt
# CLUSTER_KEY_FILE=/etc/udp-logger/certs/client.key

# Optional: TLS server name verification
# Use this if connecting via IP address but certificate is issued for a domain name
# CLUSTER_TLS_SERVER_NAME=master.example.com

# Optional: Skip certificate verification (NOT RECOMMENDED for production)
# Only use for testing or if certificate doesn't match the connection address
# CLUSTER_TLS_INSECURE_SKIP_VERIFY=true

# UDP server
UDP_ADDR=:516

# HTTP server (for metrics and health checks)
HTTP_ADDR=:9794

# Spool configuration (local disk cache)
SPOOL_DIR=/var/lib/udp-logger/spool
SPOOL_MAX_BYTES=1073741824
SPOOL_SEGMENT_BYTES=16777216
SPOOL_FSYNC=false
SPOOL_LOG_INTERVAL=30s

# Buffer configuration
BUFFER_SIZE=1000
UDP_READ_BUFFER=1024
PUBLISH_RETRY_INTERVAL=5s

