# Client mode configuration for systemd service
# This file is used by udp-logger-client.service

# Cluster mode
CLUSTER_MODE=client
MASTER_ADDR=45.156.26.242
MASTER_PORT=323833

# TLS configuration
CLUSTER_TLS=true
CLUSTER_CA_FILE=/root/rabbit-log-writer/pem.ca

# TLS options (for IP address connections)
# CLUSTER_TLS_SERVER_NAME: Set to the domain name in the certificate (if connecting via IP)
CLUSTER_TLS_SERVER_NAME=

# CLUSTER_TLS_INSECURE_SKIP_VERIFY: Set to "true" to skip certificate verification (not recommended for production)
CLUSTER_TLS_INSECURE_SKIP_VERIFY=true

# UDP server
UDP_ADDR=:516

# HTTP server (for metrics and health checks)
HTTP_ADDR=:9794

# Spool configuration (local disk cache)
SPOOL_DIR=/tmp/udp-logger-spool
SPOOL_MAX_BYTES=1073741824
SPOOL_SEGMENT_BYTES=16777216
SPOOL_FSYNC=false
SPOOL_LOG_INTERVAL=30s

# Buffer configuration
BUFFER_SIZE=1000
UDP_READ_BUFFER=1024
PUBLISH_RETRY_INTERVAL=5s

